PORT=4000
NODE_ENV=development

# Local (docker): postgres://postgres:postgres@localhost:5433/territorial_app
# Supabase (Session Pooler, recomendado): postgres://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5433/territorial_app
# Poner en true cuando se use Supabase u otro Postgres remoto con SSL
DATABASE_SSL=false

JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
